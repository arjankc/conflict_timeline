{
  "name": "nepal-conflict-timeline",
  "private": true,
  "version": "0.1.0",
  "description": "A chronological record of Nepal's internal armed conflict (1 November 1995 - 8 September 2025).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/keyword-taxonomy.mjs && tsc -b && vite build && node scripts/year-pages.mjs && node scripts/event-pages.mjs && node scripts/sitemap.mjs && node scripts/events-json.mjs",
    "lint": "oxlint",
    "data:lint": "node scripts/data-lint.mjs",
    "link:check": "node scripts/link-check.mjs",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:video": "node scripts/demo-video/run.mjs",
    "demo:assemble": "node scripts/demo-video/assemble.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
