# Optional. Published Google Sheets CSV URL, or any CSV endpoint.
# When unset, the app loads public/data/mastersheet.csv, falling back to
# public/data/events.json (generated at build) when the CSV is unreachable.
# VITE_DATA_URL=

# Public origin used in Open Graph tags, sitemap.xml, and robots.txt.
# No trailing slash. GitHub Actions sets this automatically on deploy.
# VITE_SITE_URL=https://YOUR-GITHUB-USERNAME.github.io/conflict_timeline
